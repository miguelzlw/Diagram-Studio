# Copie para .env e preencha os valores.

# Banco de dados PostgreSQL (ex: Neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Segredo do NextAuth — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# URL pública da aplicação (necessário em produção)
AUTH_URL="https://seu-dominio.vercel.app"
